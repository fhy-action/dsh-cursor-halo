{
  "name": "@local/dsh-cursor-halo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek-blue cursor halo with a continuous trail, click snap, overlay controls, and English, Chinese, French, Russian and Japanese settings.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
