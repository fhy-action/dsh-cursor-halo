{
  "name": "@fhy-action/dsh-cursor-halo",
  "version": "2.0.1",
  "type": "module",
  "description": "DeepSeek-blue cursor halo with a continuous trail, click snap, overlay controls, and English, Chinese, French, Russian and Japanese settings.",
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cursor",
    "halo",
    "overlay",
    "i18n"S
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
